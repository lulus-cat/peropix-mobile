# ── 올리지 않는 것 ───────────────────────────────────────────────────────

# 의존성 — package.json 으로 다시 받는다 (수백 MB)
node_modules/

# 빌드 산출물
android/build/
android/app/build/
android/.gradle/
android/captures/
android/.idea/
android/app/release/
*.apk
*.aab
*.keystore
*.jks

# ★단 하나 예외 — android/peropix.keystore 는 일부러 올린다.
#   비밀이 아니다. 암호가 build.gradle 에 그대로 적혀 있고, 하는 일은 "같은 앱임" 을
#   표시해 덮어 설치가 되게 하는 것뿐이다. 이것이 저장소에 없으면 빌드할 때마다
#   서명이 달라져 새 APK 가 폰에 안 깔린다.
#   ★진짜 배포용 열쇠를 쓰게 되면 그때는 여기 두지 말고 GitHub Secrets 로 옮길 것.
!android/peropix.keystore

# ★기기마다 다른 경로가 들어 있다. 받는 쪽에서 새로 만들어야 한다.
android/local.properties

# ★검사용 기준 이미지 (약 7MB). make_image_fixtures.py 로 다시 만든다.
tools/fixtures/

# 수신함이 실제로 받은 이미지 (있다면)
images/

# 편집기·OS 부스러기
.DS_Store
Thumbs.db
*.swp
.vscode/

# 파이썬 바이트코드 캐시
__pycache__/
*.pyc
