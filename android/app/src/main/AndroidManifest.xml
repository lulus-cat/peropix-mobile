<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    
        <!-- 뽑는 동안 · 모델 받는 동안만 돈다. 끝나면 앱이 직접 멈춘다. -->
        <service
            android:name=".KeepAwakeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

</application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 새 버전 APK 를 받아서 설치 화면을 띄우기 위한 것. 조용히 깔지는 못하고,
         이 권한이 있어야 "설치하시겠습니까" 화면까지 갈 수 있다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- ★안드로이드 13 부터는 알림을 띄우려면 이 권한을 **직접 적어 두어야** 물어볼 수
         있다. 안 적어 두면 「허용」 을 눌러도 실제로는 안 붙어서, 알림이 뜰 때마다
         또 물어보는 것처럼 보인다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ★몇 분씩 걸리는 일을 하는 동안 앱이 재워지지 않게 한다. 안 그러면 다른 앱을
         잠깐 보고 돌아왔을 때 WebView 가 멈춰 있고 DNS 도 막혀서
         「인터넷 연결이 끊겼습니다」 가 뜬다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
